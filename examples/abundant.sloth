func isAbundant(n) {
    var i = 1 + (var sum = 0);
    
    while (i < n) {
        if n % i == 0 {
            sum += i;
        }
        i += 1;
    }

    if sum > n {
        return true;
    }

    return false;
}

var num = getInt("Enter a number:");

if isAbundant(num) {
    print(num + " is an Abundant number");
} else {
    print(num + " is not an Abundant number");
}